# Deal Truth API — PRODUCTION. Copy to the Oracle VM as .env. Empty placeholders only.
# Fill every YOU MUST FILL line. Never commit real secrets.
# Pair with deal-truth-ml wrangler deploy. See docs/DEPLOYMENT.md

APP_NAME=deal-truth-api
APP_ENV=production
LOG_LEVEL=INFO

# Public HTTPS origin of THIS API (Caddy / reserved domain). Used for docs links.
# PyAI audio_url/webhook still need a URL PyAI can fetch — set NGROK_* or a public Caddy host.
PUBLIC_API_BASE_URL=https://REPLACE_API_HOST
# Web app origin used in share links (deal-truth-web).
PUBLIC_WEB_BASE_URL=https://REPLACE_WEB_HOST

# Production: prefer a stable public host (Caddy) and disable ngrok.
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
NGROK_API_URL=http://127.0.0.1:4040
NGROK_WAIT_SECONDS=30
NGROK_UPSTREAM=http://127.0.0.1:8000

# YOU MUST FILL — do not ship AUTH_MODE=none on a public URL.
AUTH_MODE=api_key
API_KEYS=
# YOU MUST FILL — Cloudflare Pages origin(s), comma-separated, no trailing slash
CORS_ORIGINS=https://REPLACE_PAGES_HOST

# YOU MUST FILL — Supabase Postgres (Transaction pooler 6543 for API; Session 5432 for Alembic if needed)
DATABASE_URL=postgresql+asyncpg://postgres.REPLACE:REPLACE@REPLACE.pooler.supabase.com:6543/postgres
DATABASE_SYNC_URL=postgresql+psycopg://postgres.REPLACE:REPLACE@REPLACE.pooler.supabase.com:5432/postgres

# YOU MUST FILL — Valkey/Redis on the VM (or managed)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# YOU MUST FILL — Supabase Storage S3 or SeaweedFS on the VM
S3_ENDPOINT_URL=https://REPLACE.supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_AUDIO=deal-truth-audio
S3_BUCKET_RESULTS=deal-truth-results
S3_BUCKET_SAMPLES=deal-truth-samples
S3_USE_SSL=true
S3_ADDRESSING_STYLE=path

MAX_AUDIO_BYTES=524288000
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/wave,audio/mp4,audio/ogg,audio/webm,audio/flac,audio/x-m4a,video/mp4
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.ogg,.webm,.flac,.mp4

# YOU MUST FILL
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1
PYAI_WEBHOOK_SECRET=
PYAI_RECAP_ENABLED=true
PYAI_TRACE_ENABLED=false
PYAI_RECAP_PACK_ID=sales_outbound
PYAI_AUDIO_INPUT_MODE=audio_url
PYAI_POLL_INTERVAL_SECONDS=5
PYAI_POLL_DEADLINE_SECONDS=600

# YOU MUST FILL — deployed Worker URL + same token as wrangler secret INTERNAL_API_TOKEN
ML_SERVICE_BASE_URL=https://deal-truth-ml.REPLACE.workers.dev
ML_SERVICE_API_KEY=
ML_GENERATION_ENABLED=true

# YOU MUST FILL — random 32+ byte string
SIGNED_URL_TTL_SECONDS=900
SIGNED_URL_SECRET=
SHARE_TOKEN_TTL_SECONDS=604800
STEREO_DEFAULT_CHANNEL_SELLER=0
CONFIDENCE_THRESHOLD=0.5
SOURCE_FETCH_TIMEOUT_SECONDS=30
SOURCE_FETCH_MAX_REDIRECTS=3
