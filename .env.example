# Deal Truth API — copy to .env and fill in. Never commit real secrets.
# Empty placeholders only.

APP_NAME=deal-truth-api
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_API_BASE_URL=http://localhost:8000

# ngrok — PyAI webhooks + signed audio_url. Get a token at:
# https://dashboard.ngrok.com/get-started/your-authtoken
# Official name is NGROK_AUTHTOKEN; NGROK_AUTH_TOKEN is also accepted.
# NGROK_DOMAIN is the stable hostname (same URL on every restart).
# Copy your Dev Domain from https://dashboard.ngrok.com/domains
# (example: something.ngrok-free.app). make up pins it after the first tunnel if empty.
NGROK_ENABLED=true
NGROK_AUTHTOKEN=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
NGROK_API_URL=http://127.0.0.1:4040
NGROK_WAIT_SECONDS=30
NGROK_UPSTREAM=http://host.docker.internal:8000

# none | api_key
AUTH_MODE=none
# Comma-separated API keys when AUTH_MODE=api_key. Leave empty in examples.
API_KEYS=
# Comma-separated browser origins. Add the remote frontend origin when serving via ngrok.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (async driver for API, sync for Alembic/Celery)
DATABASE_URL=postgresql+asyncpg://deal_truth:deal_truth@localhost:5432/deal_truth
DATABASE_SYNC_URL=postgresql+psycopg://deal_truth:deal_truth@localhost:5432/deal_truth

# Redis — Celery broker + result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SeaweedFS S3-compatible API
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_AUDIO=deal-truth-audio
S3_BUCKET_RESULTS=deal-truth-results
S3_BUCKET_SAMPLES=deal-truth-samples
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path

# Upload limits
MAX_AUDIO_BYTES=524288000
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/wave,audio/mp4,audio/ogg,audio/webm,audio/flac,audio/x-m4a,video/mp4
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.ogg,.webm,.flac,.mp4

# PyAI — `make up` mints a sandbox key into .env when this is empty.
# Docs: https://docs.pyai.com/api-reference/sandbox/mint-a-sandbox-key-no-auth
PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1
PYAI_WEBHOOK_SECRET=
PYAI_RECAP_ENABLED=true
PYAI_TRACE_ENABLED=false
PYAI_RECAP_PACK_ID=sales_outbound
# audio_url | multipart
PYAI_AUDIO_INPUT_MODE=audio_url
PYAI_POLL_INTERVAL_SECONDS=5
PYAI_POLL_DEADLINE_SECONDS=600

# Hosted deal-truth-ml service
ML_SERVICE_BASE_URL=http://localhost:8081
ML_SERVICE_API_KEY=
ML_GENERATION_ENABLED=true

# HMAC secrets for signed public audio URLs (generate a random 32+ byte string)
SIGNED_URL_TTL_SECONDS=900
SIGNED_URL_SECRET=

# Share links
SHARE_TOKEN_TTL_SECONDS=604800

# Stereo default: channel 0 is seller unless the user overrides
STEREO_DEFAULT_CHANNEL_SELLER=0

# Evidence confidence floor
CONFIDENCE_THRESHOLD=0.5

# Source-URL fetch
SOURCE_FETCH_TIMEOUT_SECONDS=30
SOURCE_FETCH_MAX_REDIRECTS=3
