# Deal Truth API — copy to .env (`cp .env.example .env`). Never commit real secrets.
#
# LOCAL (make up): values below work with deal-truth-ml on :8081.
# Docker API → ML on the host/other compose: host.docker.internal:8081
# Host API (`make api`) → change ML_SERVICE_BASE_URL to http://localhost:8081
# Remote API → https://<ML ngrok host from deal-truth-ml make up>
#
# YOU MUST FILL (local): NGROK_AUTHTOKEN, NGROK_DOMAIN (API Dev Domain).
# make up fills PYAI_API_KEY, PYAI_WEBHOOK_SECRET, SIGNED_URL_SECRET, S3 keys if empty.
#
# Production: see .env.production.example and docs/DEPLOYMENT.md

APP_NAME=deal-truth-api
APP_ENV=development
LOG_LEVEL=INFO
# text (default) or json
LOG_FORMAT=text
PUBLIC_API_BASE_URL=http://localhost:8000
# Web app origin used in share links (deal-truth-web). Empty -> relative /shared/{token}.
PUBLIC_WEB_BASE_URL=http://localhost:5173

# ngrok — PyAI webhooks + signed audio_url. Inspector :4040 (ML uses :4041).
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
# Domain: https://dashboard.ngrok.com/domains  (MUST differ from ML NGROK_DOMAIN)
# Second reserved domain for Render → local Seaweed (`make seaweed-tunnel`). Optional.
NGROK_ENABLED=true
NGROK_AUTHTOKEN=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
NGROK_SEAWEED_DOMAIN=deal-truth-seaweed.ngrok-free.app
NGROK_API_URL=http://127.0.0.1:4040
NGROK_WAIT_SECONDS=30
NGROK_UPSTREAM=http://host.docker.internal:8000

AUTH_MODE=none
API_KEYS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres: local Docker (profile local-db) or Supabase Session pooler from .env.
# docker compose does NOT override DATABASE_* — set the target here.
# Local:  postgresql+asyncpg://deal_truth:deal_truth@localhost:5432/deal_truth
# Supabase Session pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?ssl=require
# DATABASE_SYNC_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://deal_truth:deal_truth@localhost:5432/deal_truth
DATABASE_SYNC_URL=postgresql+psycopg://deal_truth:deal_truth@localhost:5432/deal_truth
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_AUDIO=deal-truth-audio
S3_BUCKET_RESULTS=deal-truth-results
S3_BUCKET_SAMPLES=deal-truth-samples
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path

MAX_AUDIO_BYTES=524288000
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/wave,audio/mp4,audio/ogg,audio/webm,audio/flac,audio/x-m4a,video/mp4
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.ogg,.webm,.flac,.mp4

PYAI_API_KEY=
PYAI_BASE_URL=https://api.pyai.com/v1
PYAI_WEBHOOK_SECRET=
PYAI_RECAP_ENABLED=true
PYAI_TRACE_ENABLED=false
PYAI_RECAP_PACK_ID=sales_outbound
PYAI_AUDIO_INPUT_MODE=audio_url
PYAI_POLL_INTERVAL_SECONDS=5
PYAI_POLL_DEADLINE_SECONDS=1800

# deal-truth-ml (other repo). Local wrangler dev listens on :8081
# (host.docker.internal:8081 when this API runs in Docker).
# Deployed service: https://deal-truth-ml.onrender.com
ML_SERVICE_BASE_URL=http://host.docker.internal:8081
ML_SERVICE_API_KEY=
# Items per ML request; must not exceed the Worker's MAX_BATCH_SIZE (default 32).
ML_MAX_BATCH_SIZE=32
ML_GENERATION_ENABLED=true

SIGNED_URL_TTL_SECONDS=900
SIGNED_URL_SECRET=
SHARE_TOKEN_TTL_SECONDS=604800
STEREO_DEFAULT_CHANNEL_SELLER=0
CONFIDENCE_THRESHOLD=0.5
SOURCE_FETCH_TIMEOUT_SECONDS=30
SOURCE_FETCH_MAX_REDIRECTS=3

# Hosts accepted by POST /api/v1/integrations/slack. Comma separated.
# The webhook URL itself is user data and lives in the database, never here.
SLACK_WEBHOOK_HOSTS=hooks.slack.com
